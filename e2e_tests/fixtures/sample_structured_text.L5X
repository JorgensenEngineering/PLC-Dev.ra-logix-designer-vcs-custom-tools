<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Structured text fixture.

  Both ST routines carry a <Description>, which the exploded representation must preserve. The
  routine element is stored alongside the .st file precisely so that content the serializer knows
  nothing about survives a round trip.

  Covers both configs that split routines out: one AOI routine and one Program routine.
-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="38.00" TargetName="StProject" TargetType="Controller" ContainsContext="false" Owner="TestUser" ExportDate="Mon Apr 07 10:00:00 2025" ExportOptions="NoRawData L5KData DecoratedData Dependencies ForceProtectedEncoding AllProjDocTrans">
  <Controller Use="Target" Name="StProject" ProcessorType="1756-L85E" MajorRev="38" MinorRev="11" TimeSlice="20" ShareUnusedTimeSlice="1" ProjectCreationDate="Mon Jan 01 00:00:00 2024" LastModifiedDate="Mon Apr 07 10:00:00 2025" SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" SFCLastScan="DontScan" ProjectSN="16#0000_0000" MatchProjectToController="false" CanUseRPIFromProducer="false" InhibitAutomaticFirmwareUpdate="0" PassThroughConfiguration="EnabledWithAppend" DownloadProjectDocumentationAndExtendedProperties="true" DownloadProjectCustomProperties="true" ReportMinorOverflow="false">
    <DataTypes />
    <Modules>
      <Module Name="Local" CatalogNumber="1756-L85E" Vendor="1" ProductType="14" ProductCode="166" Major="36" Minor="11" ParentModule="Local" ParentModPortId="1" Inhibited="false" MajorFault="true">
        <EKey State="Disabled" />
        <Ports>
          <Port Id="1" Address="0" Type="ICP" Upstream="false" />
        </Ports>
      </Module>
    </Modules>
    <AddOnInstructionDefinitions>
      <AddOnInstruction Name="StAoi" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2024-01-01T00:00:00.000Z" CreatedBy="TestUser" EditedDate="2024-01-01T00:00:00.000Z" EditedBy="TestUser" SoftwareRevision="v38.00">
        <Dependencies />
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData>
          </Parameter>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
            <DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
            <DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData>
          </Parameter>
          <Parameter Name="Counter" TagType="Base" DataType="DINT" Usage="InOut" Required="true" Visible="true" ExternalAccess="Read/Write" />
        </Parameters>
        <LocalTags />
        <Routines>
          <Routine Name="AoiStLogic" Type="ST">
            <Description>
              <![CDATA[AOI structured text routine description]]>
            </Description>
            <STContent>
              <Line Number="0"><![CDATA[Counter := Counter + 1;]]></Line>
              <Line Number="1"><![CDATA[IF Counter > 10 THEN]]></Line>
              <Line Number="2"><![CDATA[    Counter := 0;]]></Line>
              <Line Number="3"><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
          <!--
            Lines that stress the XML round trip: markup characters, a bare ampersand, trailing
            whitespace, and two lines containing ]]> which cannot fit in a single CDATA section
            and therefore arrive already split across two.
          -->
          <Routine Name="AoiStEdgeCases" Type="ST">
            <Description>
              <![CDATA[Lines that stress XML escaping]]>
            </Description>
            <STContent>
              <Line Number="0"><![CDATA[IF x < 5 AND y > 3 THEN]]></Line>
              <Line Number="1"><![CDATA[s := 'A & B';]]></Line>
              <Line Number="2"><![CDATA[IF a[b[i]]]]><![CDATA[> 0 THEN]]></Line>
              <Line Number="3"><![CDATA[tag := '<![CDATA[not really]]]]><![CDATA[>';]]></Line>
              <Line Number="4"><![CDATA[(* trailing spaces   *)]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </AddOnInstruction>
    </AddOnInstructionDefinitions>
    <Tags />
    <Programs>
      <Program Name="MainProgram" TestEdits="false" MainRoutineName="ProgramStLogic" Disabled="false" UseAsFolder="false">
        <Tags />
        <Routines>
          <Routine Name="ProgramStLogic" Type="ST">
            <Description>
              <![CDATA[Program structured text routine description]]>
            </Description>
            <STContent>
              <Line Number="0"><![CDATA[(* entry point *)]]></Line>
              <Line Number="1"><![CDATA[StAoi(LocalCounter);]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Rate="10" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
